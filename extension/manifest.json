{
  "manifest_version": 3,
  "name": "Gaddi",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Your Chrome, shared with your AI agents.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "nativeMessaging",
    "tabGroups",
    "bookmarks",
    "alarms",
    "storage",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/extension/bg.js",
    "type": "module"
  },
  "action": {
    "default_title": "Your Chrome, shared with your AI agents.",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
